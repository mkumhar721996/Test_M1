{
  "color-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1019607843, 0.1019607843, 0.1019607843],
      "hex": "#1a1a1a"
    },
    "$description": "Default body text color on light backgrounds. Paired with color-bg it clears WCAG AA (16.1:1)."
  },
  "color-fg-muted": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.2941176471, 0.3333333333, 0.3882352941],
      "hex": "#4b5563"
    },
    "$description": "Secondary/muted text, e.g. helper copy and captions."
  },
  "color-bg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Default page background."
  },
  "color-surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9725490196, 0.9803921569, 0.9882352941],
      "hex": "#f8fafc"
    },
    "$description": "Slightly recessed surface used behind cards and chips."
  },
  "color-primary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1450980392, 0.3882352941, 0.9215686275],
      "hex": "#2563eb"
    },
    "$description": "Brand/primary action color."
  },
  "color-primary-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Text/icon color used on top of color-primary."
  },
  "color-border": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8196078431, 0.8352941176, 0.8588235294],
      "hex": "#d1d5db"
    },
    "$description": "Default hairline border for cards, inputs, and dividers."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Smallest spacing increment."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 0.875, "unit": "rem" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "rem" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 1.25, "unit": "rem" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700
  },
  "line-height-base": {
    "$type": "number",
    "$value": 1.5
  },
  "shadow-sm": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0.1019607843, 0.1019607843, 0.1019607843],
        "alpha": 0.08,
        "hex": "#1a1a1a"
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 3, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Resting elevation shadow for cards."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "chip-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "chip-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  },
  "input-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "input-default-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}"
  }
}
