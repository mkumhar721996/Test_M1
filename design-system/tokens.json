{
  "color-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9764705882, 0.9803921569, 0.9843137255],
      "hex": "#f9fafb"
    },
    "$description": "Default body text color on dark backgrounds. Paired with color-bg it clears WCAG AA (16.98:1)."
  },
  "color-fg-muted": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.6117647059, 0.6392156863, 0.6862745098],
      "hex": "#9ca3af"
    },
    "$description": "Secondary/muted text, e.g. helper copy and captions."
  },
  "color-bg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.06666666667, 0.09411764706, 0.1529411765],
      "hex": "#111827"
    },
    "$description": "Default page background."
  },
  "color-surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1215686275, 0.1607843137, 0.2156862745],
      "hex": "#1f2937"
    },
    "$description": "Slightly raised surface used behind cards and chips."
  },
  "color-primary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.2313725490, 0.5098039216, 0.9647058824],
      "hex": "#3b82f6"
    },
    "$description": "Brand/primary action color."
  },
  "color-primary-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    },
    "$description": "Text/icon color used on top of color-primary."
  },
  "color-border": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.2156862745, 0.2549019608, 0.3176470588],
      "hex": "#374151"
    },
    "$description": "Default hairline border for cards, inputs, and dividers."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Smallest spacing increment."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 0.875, "unit": "rem" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "rem" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 1.25, "unit": "rem" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700
  },
  "line-height-base": {
    "$type": "number",
    "$value": 1.5
  },
  "shadow-sm": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 3, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Resting elevation shadow for cards. Darker/heavier than the light-theme value so it still reads against a dark page background."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "chip-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "chip-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  },
  "input-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "input-default-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}"
  }
}
