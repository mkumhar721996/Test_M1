{
  "color-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9607843137, 0.9490196078, 0.9843137255],
      "hex": "#f5f2fb"
    },
    "$description": "Default body text color on dark backgrounds. Paired with color-bg it clears WCAG AA (16.7:1)."
  },
  "color-fg-muted": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.6901960784, 0.6352941176, 0.8078431373],
      "hex": "#b0a2ce"
    },
    "$description": "Secondary/muted text, e.g. helper copy and captions."
  },
  "color-bg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.09411764706, 0.06274509804, 0.1294117647],
      "hex": "#181021"
    },
    "$description": "Default page background. Deep purple/violet ink."
  },
  "color-surface": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1607843137, 0.1098039216, 0.2392156863],
      "hex": "#291c3d"
    },
    "$description": "Slightly raised surface used behind cards and chips. Purple-tinted, lighter than color-bg."
  },
  "color-primary": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.6588235294, 0.3333333333, 0.9686274510],
      "hex": "#a855f7"
    },
    "$description": "Brand/primary action color. Purple/violet. High relative luminance, so color-primary-fg switches to a dark ink to keep contrast against it at least 4.5:1 (white text would fail)."
  },
  "color-primary-fg": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0, 0, 0],
      "hex": "#000000"
    },
    "$description": "Text/icon color used on top of color-primary. Black, since color-primary is a light violet/purple and white text would not clear WCAG AA against it."
  },
  "color-border": {
    "$type": "color",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.2509803922, 0.1960784314, 0.3607843137],
      "hex": "#40325c"
    },
    "$description": "Default hairline border for cards, inputs, and dividers. Purple-tinted grey."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Smallest spacing increment."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 0.875, "unit": "rem" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "rem" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 1.25, "unit": "rem" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700
  },
  "line-height-base": {
    "$type": "number",
    "$value": 1.5
  },
  "shadow-sm": {
    "$type": "shadow",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "alpha": 0.4,
        "hex": "#000000"
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 3, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Resting elevation shadow for cards. Darker/heavier than the light-theme value so it still reads against a dark page background."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "chip-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "chip-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  },
  "input-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "input-default-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}"
  }
}
